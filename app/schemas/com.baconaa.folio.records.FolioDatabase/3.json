    "views": [
      {
        "viewName": "editable_text_drafts",
        "createSql": "CREATE VIEW `${VIEW_NAME}` AS SELECT d.*, d.rowid AS insertionOrder, e.recordId FROM text_drafts d\n       LEFT JOIN text_record_edits e ON e.draftId = d.id\n       LEFT JOIN text_records r ON r.id = e.recordId\n       WHERE r.deletedAt IS NULL"
      }
